# Copy to .env in this directory (spring-dotenv loads it) or export as environment variables.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ngoconnect
DB_USER=root
DB_PASSWORD=
JWT_SECRET=            # >= 32 characters, e.g. `openssl rand -hex 32`

# Optional: only needed if you enable email sending (verification is currently disabled)
MAIL_USERNAME=
MAIL_PASSWORD=         # use an app-specific password, never your account password
